{
  "name": "twinkl-typescript-tech-test",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --require ts-node/register --test $(find src -name '*.test.ts')",
    "test:e2e": "node --require ts-node/register --test $(find test -name '*.test.ts')",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "earl": "^2.0.0",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.1"
  }
}
